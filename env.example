PROJECTS_DIRECTORY=./..

# The suffix of the project names. Every name under localdev.it resolves to
# 127.0.0.1 and ::1 for anyone, so this default needs no setup at all:
# projecta.localdev.it just works. With a suffix of your own (`local`, `test`)
# add the names to /etc/hosts.
SUFFIX=localdev.it

# PHP 7.4, 8.0, 8.1, 8.2, 8.3, 8.4, 8.5 or 8.6
PHP_VERSION=8.4

# DATABASE VERSIONS
# The version selects the image tag and the config directory
# config/<engine>/<version>. Supported versions:
#   mysql          8.0, 8.4, 9.7, 26.10
#   mariadb        10.11, 11.4, 11.8, 12.3, 13.0
#   postgres       15.1, 16, 17, 18
#   redis          7.4, 8.2, 8.4, 8.6, 8.8, 8.10
#   memcached      1.6
#   elasticsearch  7.14.2, 8.19.23, 9.5.5
MYSQL_VERSION=8.0
MARIADB_VERSION=10.11
POSTGRES_VERSION=15.1
REDIS_VERSION=8.10
MEMCACHED_VERSION=1.6
ELASTICSEARCH_VERSION=7.14.2

# MYSQL CONFIGURATION (see https://hub.docker.com/_/mysql )
DB_DATABASE=laser
DB_USERNAME=laser
DB_PASSWORD=laser
DB_ROOT_PASSWORD=root

# POSTGRES CONFIGURATION (see https://hub.docker.com/_/postgres )
POSTGRES_PASSWORD=postgres
# POSTGRES_USER=postgres
# POSTGRES_DB=postgres
# POSTGRES_INITDB_ARGS=
# POSTGRES_INITDB_WALDIR=
# POSTGRES_HOST_AUTH_METHOD=

# MARIADB CONFIGURATION (see https://hub.docker.com/_/mariadb )
MARIADB_DATABASE=laser
MARIADB_USER=laser
MARIADB_PASSWORD=laser
MARIADB_ROOT_PASSWORD=root

# DOCKER-COMPOSE PROFILES:
# list of additional containers you need comma separated:
# mysql, mariadb, postgres, redis, memcached, elasticsearch
# examples:
# mysql and redis:          PROFILES=mysql,redis
# mysql and memcached:      PROFILES=mysql,memcached
# mariadb and redis:        PROFILES=mariadb,redis
# postgres and elastic:     PROFILES=postgres,elasticsearch
# mysql, redis and elastic: PROFILES=mysql,redis,elasticsearch
PROFILES=mysql,redis
