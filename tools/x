#!/bin/bash
#
# Post on X as @laserstack_sdb, never as the account of the browser.
#
# X has no free API since February 2026: a post costs $0.015, and $0.20 when it
# carries a link, which is most of what this project posts. twitter-cli instead
# speaks the GraphQL of the web app with the session cookie of the account, so
# posting costs nothing. The trade is that X can rate-limit or lock the account
# of an automated session: see tools/x.md.
#
# The cookies live in one file, and this wrapper never runs twitter-cli without
# them. That guard matters: with no cookie in the environment, twitter-cli falls
# back to the cookies of the browser it finds, and a post would go out as the
# personal account. A missing file is an error, not a silent fallback.
#
# Requirements:
#   - twitter-cli: `uv tool install twitter-cli` (or pipx install twitter-cli)
#   - the cookie file, made once from the laserstack_sdb browser session:
#       $HOME/.config/laserstack/x.env  (mode 600)
#       TWITTER_AUTH_TOKEN=...
#       TWITTER_CT0=...
#
# Usage:
#   tools/x whoami                         # which account the cookies belong to
#   tools/x post "Laser Stack 2.0 is out"  # a post
#   tools/x post "text" -i docs/og.png     # with an image
#   tools/x reply <tweet-id> "text"
#   tools/x feed --max 20                  # read the timeline of that account
#   tools/x search "laserstack" -t Latest
#
# X_ENV points at another cookie file; TWITTER_BIN at another installation.

set -euo pipefail

X_ENV="${X_ENV:-$HOME/.config/laserstack/x.env}"
TWITTER_BIN="${TWITTER_BIN:-$(command -v twitter || printf '%s' "$HOME/.local/bin/twitter")}"

die() { printf 'tools/x: %s\n' "$*" >&2; exit 1; }

[ -x "$TWITTER_BIN" ] || die "twitter-cli not found; run: uv tool install twitter-cli"
[ -f "$X_ENV" ] || die "no credentials at $X_ENV; create them as tools/x.md describes"

# Read only the two names this needs. Sourcing the file would run it.
cred() {
  sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" "$X_ENV" | tail -n 1 | tr -d "\"' \r"
}

TWITTER_AUTH_TOKEN="$(cred TWITTER_AUTH_TOKEN)"
TWITTER_CT0="$(cred TWITTER_CT0)"
export TWITTER_AUTH_TOKEN TWITTER_CT0

[ -n "$TWITTER_AUTH_TOKEN" ] && [ -n "$TWITTER_CT0" ] ||
  die "$X_ENV lacks TWITTER_AUTH_TOKEN or TWITTER_CT0; refusing to run, because twitter-cli would then use the cookies of the browser account"

exec "$TWITTER_BIN" "$@"
