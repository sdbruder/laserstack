#!/bin/bash
#
# Post on X as @laserstackphp, never as the account of a browser.
#
# X has no free API since February 2026: a post costs $0.015, and $0.20 when it
# carries a link, which is most of what this project posts. twitter-cli instead
# speaks the GraphQL of the web app with the session cookie of the account, so
# posting costs nothing. The trade is that X can rate-limit or lock an account
# used from an automated session: see tools/x.md.
#
# The cookie lives in the 1Password item "Laser Stack X", as the two text fields
# auth_token and ct0, and the same item holds the password, the two-factor seed
# and the recovery codes. A file at ~/.laserstack-x, mode 600, is the fallback
# for a machine without 1Password, and the environment wins over both.
#
# The wrapper refuses to run when no source answers: with no cookie in the
# environment twitter-cli extracts the cookies of whichever browser it finds,
# and that is the account the post would go out as.
#
# Requirements:
#   - twitter-cli: `uv tool install twitter-cli` (or pipx install twitter-cli)
#   - 1Password CLI on the desktop app, so that
#     `op read 'op://Personal/Laser Stack X/auth_token'` prints the cookie
#
# Usage:
#   tools/x whoami                          # must print @laserstackphp
#   tools/x post "Laser Stack 2.0 is out"   # a post
#   tools/x post "text" -i docs/og.png      # with an image
#   tools/x reply <tweet-id> "text"
#   tools/x feed --max 20                   # read the timeline of that account
#   tools/x search "laserstack" -t Latest
#
# Environment:
#   X_OP_REF      1Password reference of the item; default
#                 'op://Personal/Laser Stack X'
#   X_ENV         fallback file with TWITTER_AUTH_TOKEN and TWITTER_CT0,
#                 default ~/.laserstack-x
#   TWITTER_AUTH_TOKEN, TWITTER_CT0   explicit values, checked no further
#   TWITTER_BIN   another twitter-cli installation

set -euo pipefail

X_OP_REF="${X_OP_REF:-op://Personal/Laser Stack X}"
X_ENV="${X_ENV:-$HOME/.laserstack-x}"
TWITTER_BIN="${TWITTER_BIN:-$(command -v twitter || printf '%s' "$HOME/.local/bin/twitter")}"

die() { printf 'tools/x: %s\n' "$*" >&2; exit 1; }

[ -x "$TWITTER_BIN" ] || die "twitter-cli not found; run: uv tool install twitter-cli"

# Explicit values win, then the vault, then the file. Each step stops at the
# first source that answers, so a locked vault never blocks a run that already
# has the cookie.
if [ -z "${TWITTER_AUTH_TOKEN:-}" ] && command -v op >/dev/null 2>&1; then
  TWITTER_AUTH_TOKEN="$(op read "$X_OP_REF/auth_token" 2>/dev/null | tr -d '\r\n' || true)"
  TWITTER_CT0="$(op read "$X_OP_REF/ct0" 2>/dev/null | tr -d '\r\n' || true)"
fi

if [ -z "${TWITTER_AUTH_TOKEN:-}" ] && [ -f "$X_ENV" ]; then
  # Read only the two names this needs. Sourcing the file would run it.
  cred() {
    sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" "$X_ENV" | tail -n 1 | tr -d "\"' \r"
  }
  TWITTER_AUTH_TOKEN="$(cred TWITTER_AUTH_TOKEN)"
  TWITTER_CT0="$(cred TWITTER_CT0)"
fi

TWITTER_CT0="${TWITTER_CT0:-}"
export TWITTER_AUTH_TOKEN TWITTER_CT0

[ -n "${TWITTER_AUTH_TOKEN:-}" ] && [ -n "$TWITTER_CT0" ] ||
  die "no usable cookie in $X_OP_REF, in $X_ENV, or in the environment: TWITTER_AUTH_TOKEN and TWITTER_CT0 must both be set. Refusing to run, because twitter-cli would then extract cookies from whichever browser session it finds"

# Prove the cookie before the tool gets it. twitter-cli re-extracts the cookies
# of the browser whenever a cookie fails its verification, and that endpoint now
# answers 404 for a valid cookie of a new account, so neither its verification
# nor the browser path can be trusted here. Instead: run the tool with HOME in
# an empty directory, where no browser store exists, and ask it who it is.
X_HANDLE="${X_HANDLE:-laserstackphp}"
X_EMPTY_HOME="${X_EMPTY_HOME:-$HOME/.cache/laserstack/x-home}"
mkdir -p "$X_EMPTY_HOME"
# The tool keeps the transaction script it needs to post in ~/.twitter-cli.
# Share that directory, so posting behaves the same, and leave ~/Library out.
mkdir -p "$HOME/.twitter-cli"
ln -sfn "$HOME/.twitter-cli" "$X_EMPTY_HOME/.twitter-cli"
export HOME="$X_EMPTY_HOME"

who="$("$TWITTER_BIN" whoami --json 2>/dev/null | sed -n 's/.*"screenName"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1 || true)"

[ "$who" = "$X_HANDLE" ] ||
  die "the cookie authenticates as '${who:-nothing}', not as @$X_HANDLE. Refresh it from DevTools; this run stops here, because twitter-cli would otherwise fall back to the cookies of the browser"

exec "$TWITTER_BIN" "$@"
