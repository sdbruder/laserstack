}

function dotest() {
  project=$1
  shift
  dc exec --workdir "/var/www/$project" "$(phpservice "$project")" php artisan test "$@"
}

function share() {
  project=$1
  shift
  docker run --rm -it --network "${dockerproject}_laser" --link app wernight/ngrok ngrok http -host-header="$project.$SUFFIX" host.docker.internal:80
}

