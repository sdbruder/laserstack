#!/bin/bash
# http://redsymbol.net/articles/unofficial-bash-strict-mode/
set -euo pipefail
IFS=$'\n\t '

function color_message() {
  COLOR="\033[1;$1m"
  NOCOLOR='\033[0m'
  echo -e "${COLOR}$2:${NOCOLOR} $3 " >&2
}

function error_message() {
  color_message 31 "ERROR" "$*"
}

function warning_message() {
  color_message 33 "WARNING" "$*"
}

# thanks https://stackoverflow.com/a/5027832
function relativepath() {
  source=$1
  target=$2
  common_part=$source
  back=
  # shellcheck disable=SC2295
  while [ "${target#$common_part}" = "${target}" ]; do
    common_part=$(dirname "$common_part")
    back="../${back}"
  done
  # shellcheck disable=SC2295
  echo "${back}${target#$common_part/}"
}

function whichproject() {
  project=$(relativepath "$projects_dir" "$current_dir")
  if [[ $project = */* ]]; then
    # warning_message "expected a subdir of ${projects_dir}. Current dir is ${current_dir}."
    project=""
  fi
  echo "$project"
}

function nih() {
  echo "Still not implemented"
}

function build_dc_params() {
  # The profiles decide which services exist: a database profile, and one
  # profile per PHP version that a project asks for besides the one of .env.
  # HTTPS=on publishes 443 and mounts the certificate that laser tls writes.
  dc_params="-f docker-compose.yml"
  if [ -n "${PROFILES:-}" ]; then
    dc_params="$dc_params --profile ${PROFILES//,/ --profile }"
  fi
  if [ "${HTTPS:-on}" == "on" ]; then
    dc_params="$dc_params -f docker-compose.https.yml"
  fi
}

function dc() {
  #shellcheck disable=SC2086
  docker-compose $dc_params "$@"
}

function up() {
  # laser tls writes the certificate the container serves into config/tls/serve,
  # which is the directory docker-compose.https.yml mounts. HTTPS is on unless
  # .env says otherwise, so a stack that never had a certificate gets one here:
  # the published one for the default suffix, the authority of this machine for
  # a suffix of your own, where laser trust is still yours to run.
  if [ "$HTTPS" == "on" ] && [ ! -f config/tls/serve/laserstack.pem ]; then
    echo "TLS: HTTPS is on and this stack has no certificate yet, provisioning one."
    tls
  fi
  # --remove-orphans: a profile that leaves PROFILES takes its container with
  # it, which is how dropping a database engine or a PHP version really stops it
  dc up -d --remove-orphans
}

