  lasercommands
}

function list() {
  # one line per servable project: its URL and the PHP version it asks for
  local project version
  cd "$projects_dir" || return 1
  for project in *; do
    [ -n "$(ls "$project/public"/*.php 2>/dev/null)" ] || continue
    version=$(awk -F= '/^PHP_VERSION=/{print $2}' "$project/.laserstack" 2>/dev/null || true)
    printf 'http://%s.%s  php %s\n' "$project" "$SUFFIX" "${version:-$PHP_VERSION}"
  done
}

function use() {
  # laser use php 8.5: the project of the current directory states its version
  # in .laserstack and the profile of that version joins PROFILES, so the stack
  # starts the container that serves it. The file is read, never sourced.
  local engine="${1:-}" version="${2:-}" project marker service profiles
  project=$(whichproject)
  if [ -z "$project" ]; then
    error_message "USE: run this inside a project of $projects_dir"
    return 1
  fi
  if [ "$engine" != "php" ]; then
    error_message "USE: php is the only version that is selectable per project yet"
    return 1
  fi
  marker="$projects_dir/$project/.laserstack"
  if [ -z "$version" ] || [ "$version" == "off" ] || [ "$version" == "default" ]; then
    rm -f "$marker"
    echo "USE: $project follows the PHP version of the stack again ($PHP_VERSION)"
    echo "USE: the profile of another version stays in PROFILES until you remove it"
    return 0
  fi
  if [ ! -d "config/php$(phpseries_dir "$version")" ]; then
    error_message "USE: config/php$(phpseries_dir "$version") does not exist, there is no PHP $version in this stack"
    return 1
  fi
  service=$(phpservice_name "$version")
  printf 'PHP_VERSION=%s\n' "$version" >"$marker"
  echo "USE: $project asks for PHP $version, .laserstack written"
  if [[ ",${PROFILES:-}," != *",$service,"* ]]; then
    profiles="${PROFILES:+$PROFILES,}$service"
    if grep -q '^PROFILES=' .env; then
      printf '%s\n' "$(sed "s/^PROFILES=.*/PROFILES=$profiles/" .env)" >.env
    else
      echo "PROFILES=$profiles" >>.env
    fi
    PROFILES="$profiles"
    build_dc_params
    echo "USE: $service added to PROFILES in .env"
  fi
  up
  scan
  echo "USE: $project is served on http://$project.${SUFFIX:-localdev.it}/ by $service"
}

# Opens a URL in the browser of the machine that runs the stack. The WSL
# browser runs on Windows, so it takes the Windows opener; everything else is
# open on macOS and xdg-open on Linux.
function openurl() {
  local url=${1}
  if [ -n "$WSL" ]; then
    if command -v wslview >/dev/null 2>&1; then
      wslview "$url"
    else
      powershell.exe -Command "Start-Process '$url'"
    fi
  elif command -v open >/dev/null 2>&1; then
    open "$url"
  elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$url"
  else
    echo "DASHBOARD: open this address in your browser: $url"
  fi
}

# The dashboard of the stack: the checkout is one of the projects the stack
# serves, so the page answers on its own name and needs no vhost of its own.
function dashboard() {
  local scheme=http
  if [ "$HTTPS" == "on" ]; then
    scheme=https
  fi
  local url="$scheme://laserstack.${SUFFIX:-localdev.it}/"
  echo "DASHBOARD: $url"
  openurl "$url"
}

function stats() {
  docker stats
}

function artisan() {
  project=$1
  shift
  dc exec --workdir "/var/www/$project" "$(phpservice "$project")" php artisan "$@"
}

function composer() {
  project=$1
  shift
  dc exec --workdir "/var/www/$project" "$(phpservice "$project")" composer "$@"
}

function dbhost() {
  # Host name of the database container. The service of the mysql profile is
  # "db", the service of the mariadb profile is "mariadb".
  if [[ ",${PROFILES:-}," == *",mariadb,"* ]]; then
    echo mariadb
  else
    echo db
  fi
}

function phpservice() {
  # Service that serves a project: the app container, unless the project states
  # a version of its own in .laserstack. That file is read, never sourced: a
  # project file must not be able to run code during a scan.
  local project=$1 marker="$projects_dir/$1/.laserstack" version
  version=$(awk -F= '/^PHP_VERSION=/{print $2}' "$marker" 2>/dev/null || true)
  if [ -n "$version" ] && [ "$version" != "$PHP_VERSION" ]; then
    phpservice_name "$version"
  else
    echo app
  fi
}

function mysql() {
  local host pass dbname client=mysql
  local args=()
  host=$(dbhost)
  if [ "$host" == "mariadb" ]; then
    pass="${MARIADB_ROOT_PASSWORD:-root}"
    dbname="${MARIADB_DATABASE:-}"
    # the MariaDB images ship no "mysql" binary from 11.4 on, only "mariadb"
    client=mariadb
  else
    pass="${DB_ROOT_PASSWORD:-root}"
    dbname="${DB_DATABASE:-}"
  fi
  args=(-u root "-p$pass")
  # the database of the profile, only when the caller gives no argument of its
  # own, the client takes the first positional argument as the database
  if [ "$#" -eq 0 ] && [ -n "$dbname" ]; then
    args+=("$dbname")
  fi
  # the client that ships with the server knows every authentication plugin of
  # that server, and the local unix socket is a secure transport for
  # caching_sha2_password, so neither TLS nor the RSA exchange take part. The
  # arguments go to the client as they are, no shell in between.
  dc exec "$host" "$client" "${args[@]}" "$@"
}

function psql() {
  local pass user dbname
  local args=()
  pass="${POSTGRES_PASSWORD:-postgres}"
  user="${POSTGRES_USER:-postgres}"
  dbname="${POSTGRES_DB:-}"
  args=(-h postgres -U "$user")
  if [ "$#" -eq 0 ] && [ -n "$dbname" ]; then
    args+=("$dbname")
  fi
  dc exec -e "PGPASSWORD=$pass" app psql "${args[@]}" "$@"
}

function appversion() {
  # the PHP version of the running app container, empty when it is not up
  dc exec -T app php -r 'echo PHP_VERSION;' 2>/dev/null || true
}

function update() {
  # laser update [--check]: the newest code of the checkout and the newest
  # images of the active profiles, then restart what changed.
  # The image of a PHP series is rebuilt every night in laserstack_app, so this
  # is how a newer patch of the series reaches a running stack.
  local check=0
  [ "${1:-}" == "--check" ] && check=1
  local image="laserstack/app:${PHP_VERSION}"

  if [ -d .git ]; then
    echo "-- the checkout"
    if [ "$check" -eq 1 ]; then
      git fetch --quiet origin || warning_message "could not reach origin"
      git status --short --branch | sed -n 1p
    else
      git pull --ff-only || warning_message "the checkout has local changes, the images below are updated anyway"
    fi
  fi

  echo "-- the images of the active profiles"
  #shellcheck disable=SC2086
  dc pull

  echo "-- the app image"
  echo "   $image carries PHP $(docker run --rm --entrypoint php "$image" -r 'echo PHP_VERSION;' 2>/dev/null || echo unknown)"
  echo "   the app container runs PHP $(appversion)"

  # a worker container serves another version of a project, see phpservice
  local service version
  for service in $(echo "${PROFILES:-}" | tr ',' '\n' | grep -E '^php[0-9]+$' || true); do
    version=$(dc exec -T "$service" php -r 'echo PHP_VERSION;' 2>/dev/null || echo "not up")
    echo "   $service runs PHP $version"
  done

  if [ "$check" -eq 1 ]; then
    echo "-- check only, nothing restarted"
    return 0
  fi

  echo "-- restarting what changed"
  dc up -d --remove-orphans
  echo "-- the app container now runs PHP $(appversion)"
}

function stackisup() {
  dc ps -q
}

function restartphp() {
  dc exec app /usr/bin/supervisorctl restart php-fpm
}

function restartnginx() {
  dc exec app /usr/bin/supervisorctl restart nginx
}

function restart_nginx_if_up() {
  isup=$(stackisup)
  if [ -n "$isup" ]; then
    echo "Laser Stack is up, restarting nginx."
    restartnginx
  fi
}

function tls::fetch_published() {
  # The published certificate of the default suffix is issued once, on a server,
  # and served from a public address, so every browser trusts it with no setup on
  # the machine. Its key is public by design, the way the ones of local-ip.co and
  # traefik.me are, and its names are only the catch-all domain, so no project
  # name of any user ever reaches a certificate transparency log.
  local serve_dir="$1"
  local suffix="$2"
  local base="${LASER_TLS_BASE:-https://localdev.it/laserstack/tls}"
  local tmp
  tmp=$(mktemp -d) || return 1
  if ! curl -fsS --max-time 20 -o "$tmp/fullchain.pem" "$base/fullchain.pem" 2>/dev/null ||
    ! curl -fsS --max-time 20 -o "$tmp/privkey.pem" "$base/privkey.pem" 2>/dev/null; then
    rm -rf "$tmp"
    return 1
  fi
  if ! openssl x509 -in "$tmp/fullchain.pem" -noout -checkhost "laserstack.$suffix" >/dev/null 2>&1; then
    warning_message "TLS: the published certificate does not cover *.$suffix"
    rm -rf "$tmp"
    return 1
  fi
  if ! openssl x509 -in "$tmp/fullchain.pem" -noout -checkend 604800 >/dev/null 2>&1; then
    warning_message "TLS: the published certificate expires within a week"
    rm -rf "$tmp"
    return 1
  fi
  install -m 644 "$tmp/fullchain.pem" "$serve_dir/laserstack.pem" &&
    install -m 600 "$tmp/privkey.pem" "$serve_dir/laserstack-key.pem"
  rm -rf "$tmp"
}

function tls() {
  # Two sources of a certificate. The published certificate of the default
  # suffix is real, public, and already trusted by every browser, so no machine
  # has to trust anything; the certificate authority of this machine covers a
  # suffix of your own, which no public certificate can, and laser trust adds it
  # to the trust store of the platform.
  #
  # The CA stays in ca/, what the container serves stays in serve/. Only serve/
  # is mounted, and it is mounted as a directory: a bind mount of a single file
  # keeps the inode, so reissuing would leave the container with the old file.
  local requested="${1:-}"
  local dir="config/tls"
  local ca_dir="$dir/ca"
  local serve_dir="$dir/serve"
  local ca="$ca_dir/laserstack-local-ca.pem"
  local ca_key="$ca_dir/laserstack-local-ca-key.pem"
  local leaf="$serve_dir/laserstack.pem"
  local leaf_key="$serve_dir/laserstack-key.pem"
  local marker="$serve_dir/suffix"
  local source_file="$serve_dir/source"
  local default_suffix="localdev.it"
  mkdir -p "$ca_dir" "$serve_dir"

  # The certificate names every project of the projects directory explicitly.
  # A wildcard over a suffix of one label (*.mac) is refused by macOS and by
  # other verifiers, so the names have to be in the certificate. The list is
  # hashed into the marker file, so adding a project and running laser tls again
  # reissues the certificate.
  local san="DNS:$SUFFIX, DNS:*.$SUFFIX, DNS:localhost, IP:127.0.0.1"
  local names=""
  local name
  for name in "$projects_dir"/*; do
    [ -d "$name" ] || continue
    name=$(basename "$name")
    case "$name" in
    *[!A-Za-z0-9._-]*) continue ;;
    esac
    san="$san, DNS:$name.$SUFFIX"
    names="$names$name\n"
  done
  printf '%b' "$names" >"$serve_dir/names.txt"
  local names_hash
  if command -v md5sum >/dev/null 2>&1; then
    names_hash=$(md5sum "$serve_dir/names.txt" | awk '{print $1}')
  else
    names_hash=$(md5 -q "$serve_dir/names.txt")
  fi

  # Which certificate does this stack serve?
  local source=""
  [ -f "$source_file" ] && source=$(cat "$source_file")
  local fresh=1
  if [ -f "$leaf" ] && openssl x509 -checkend 2592000 -noout -in "$leaf" >/dev/null 2>&1; then
    fresh=0
  fi
  local wanted="local"
  if [ "$requested" == "--global" ]; then
    wanted="global"
  elif [ "$requested" == "--local" ]; then
    wanted="local"
  elif [ "$SUFFIX" == "$default_suffix" ]; then
    wanted="global"
  fi

  if [ "$wanted" == "global" ]; then
    if [ "$source" == "global" ] && [ "$fresh" == "0" ]; then
      echo "TLS: the published certificate of $default_suffix is in place and valid"
    elif tls::fetch_published "$serve_dir" "$SUFFIX"; then
      source="global"
      printf '%s' "global" >"$source_file"
      echo "TLS: serving the published certificate of $default_suffix: real, public, and already trusted by every browser"
    else
      warning_message "TLS: the published certificate could not be fetched, using the CA of this machine"
      wanted="local"
    fi
  fi

  if [ "$wanted" == "local" ] && { [ ! -f "$ca" ] || [ ! -f "$ca_key" ]; }; then
    echo "TLS: creating the local certificate authority of this machine"
    openssl req -x509 -newkey rsa:2048 -sha256 -days 3650 -nodes \
      -keyout "$ca_key" -out "$ca" \
      -subj "/CN=Laser Stack local CA/O=Laser Stack" 2>/dev/null
    chmod 600 "$ca_key"
  fi

  local issued=""
  [ -f "$marker" ] && issued=$(cat "$marker")
  local expired=1
  if [ -f "$leaf" ] && openssl x509 -checkend 2592000 -noout -in "$leaf" >/dev/null 2>&1; then
    expired=0
  fi
  # the certificate on disk has to be the local one and to cover this suffix: it
  # could be the published one from an earlier run, which covers another domain
  if ! openssl x509 -in "$leaf" -noout -checkhost "laserstack.$SUFFIX" >/dev/null 2>&1; then
    issued=""
  fi

  # a new suffix needs a new certificate: the certificate carries the names
  if [ "$wanted" == "local" ] &&
    { [ "$issued" != "local:$SUFFIX:$names_hash" ] || [ "$expired" == "1" ] || [ ! -f "$leaf_key" ]; }; then
    echo "TLS: issuing a certificate for $SUFFIX and $(wc -l <"$serve_dir/names.txt" | tr -d ' ') projects, valid 825 days"
    cat >"$serve_dir/leaf.ext" <<EXT
subjectAltName = $san
basicConstraints = CA:FALSE
keyUsage = digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth
EXT
    openssl req -newkey rsa:2048 -sha256 -nodes -keyout "$leaf_key" -out "$serve_dir/leaf.csr" \
      -subj "/CN=*.$SUFFIX/O=Laser Stack" 2>/dev/null
    openssl x509 -req -in "$serve_dir/leaf.csr" -CA "$ca" -CAkey "$ca_key" -CAcreateserial \
      -out "$leaf" -days 825 -sha256 -extfile "$serve_dir/leaf.ext" 2>/dev/null
    rm -f "$serve_dir/leaf.csr" "$serve_dir/leaf.ext" "$ca_dir/laserstack-local-ca.srl"
    chmod 600 "$leaf_key"
    printf '%s' "local:$SUFFIX:$names_hash" >"$marker"
  elif [ "$wanted" == "local" ]; then
    echo "TLS: the certificate of the CA of this machine is in place for $SUFFIX, with $(wc -l <"$serve_dir/names.txt" | tr -d ' ') project names"
  fi
  if [ "$wanted" == "local" ]; then
    printf '%s' "local" >"$source_file"
    source="local"
  fi

  # the rendered vhost, from the same template and the same directory supervisord
  # renders the http one from. The driver owns both, so laser scan keeps the
  # pair in sync when HTTPS changes.
  # shellcheck source=/dev/null
  source libs/multilaravelDriver.sh
  multilaravel::https_vhost
  if [ "$HTTPS" == "on" ]; then
    if [ "$source" == "global" ]; then
      echo "TLS: next: laser up -d"
    else
      echo "TLS: next: laser up -d, and laser trust for the browser"
    fi
  else
    echo "TLS: set HTTPS=on in .env and run laser up -d to serve it"
  fi
  if [ "$source" == "global" ]; then
    echo "TLS: the certificate the container serves is in $serve_dir, fetched from ${LASER_TLS_BASE:-https://localdev.it/laserstack/tls}"
  else
    echo "TLS: the CA is $ca, the certificate the container serves is in $serve_dir"
  fi
}

function trust() {
  # One CA per machine, whatever the suffix is: the suffix lives in the
  # certificate that the CA signs, not in the CA. So this is one run, and a
  # later laser tls for another suffix needs no new trust.
  local action="${1:-add}"
  local ca="config/tls/ca/laserstack-local-ca.pem"
  local label="Laser Stack local CA"
  local system_ca="/usr/local/share/ca-certificates/laserstack-local-ca.crt"
  local pki_ca="/etc/pki/ca-trust/source/anchors/laserstack-local-ca.crt"
  local win_ca="/mnt/c/Users/Public/laserstack-local-ca.crt"

  if [ -f config/tls/serve/source ] && [ "$(cat config/tls/serve/source)" == "global" ]; then
    echo "TLS: this stack serves the published certificate of the default suffix."
    echo "TLS: every browser already trusts it, on every platform, and not even"
    echo "TLS: Windows needs anything. laser trust is for a suffix of your own."
    return 0
  fi

  if [ "$action" == "--remove" ] || [ "$action" == "remove" ]; then
    if [ "$(uname)" == "Darwin" ]; then
      echo "TLS: removing the CA from the system keychain"
      sudo security delete-certificate -c "$label" /Library/Keychains/System.keychain
    elif [ -n "$WSL" ]; then
      echo "TLS: removing the CA from the certificate store of Windows"
      certutil.exe -delstore -user Root "$label"
    elif command -v update-ca-certificates >/dev/null 2>&1; then
      sudo rm -f "$system_ca" && sudo update-ca-certificates --fresh
    elif command -v update-ca-trust >/dev/null 2>&1; then
      sudo rm -f "$pki_ca" && sudo update-ca-trust
    else
      error_message "TLS: no trust store tool found"
      return 1
    fi
    echo "TLS: out of the trust store. The CA and the certificates in config/tls stay."
    return 0
  fi

  if [ ! -f "$ca" ]; then
    error_message "TLS: there is no CA yet, run laser tls first"
    return 1
  fi

  if [ "$(uname)" == "Darwin" ]; then
    echo "TLS: adding the CA to the system keychain, macOS asks for your password"
    sudo security add-trusted-cert -d -r trustRoot -k /Library/Keychains/System.keychain "$ca"
  elif [ -n "$WSL" ]; then
    # The browser of a WSL user runs on Windows and reads the store of Windows,
    # not the one inside the distribution, so the CA goes there. certutil.exe
    # needs a path it can open, hence the copy out to C: first. This is the user
    # store, so it needs no administrator.
    echo "TLS: adding the CA to the certificate store of Windows (user store)"
    if [ ! -d /mnt/c/Users/Public ]; then
      error_message "TLS: /mnt/c/Users/Public is not there, is C: mounted?"
      return 1
    fi
    cp "$ca" "$win_ca" && certutil.exe -addstore -user Root "$(wslpath -w "$win_ca")"
    rm -f "$win_ca"
  elif command -v update-ca-certificates >/dev/null 2>&1; then
    echo "TLS: adding the CA to the system trust store"
    sudo cp "$ca" "$system_ca" && sudo update-ca-certificates
  elif command -v update-ca-trust >/dev/null 2>&1; then
    echo "TLS: adding the CA to the system trust store (update-ca-trust)"
    sudo cp "$ca" "$pki_ca" && sudo update-ca-trust
  else
    error_message "TLS: no trust store tool found (update-ca-certificates, update-ca-trust)"
    return 1
  fi

  echo "TLS: done. Firefox keeps its own store: import $ca there if you use it."
  echo "TLS: laser trust --remove takes it out again."
}

function scan() {
  fromscratch="${1:-preserve}"

  local changed=0
  isup=$(stackisup)
  if [ -n "$isup" ]; then
    if [ "$fromscratch" == "--fromscratch" ]; then
      echo "SCAN: starting from scratch"
      rm -f config/nginx/*
    fi
    # shellcheck disable=SC1091
    source libs/sourcedrivers.sh
    changed=$(drivers::scan_projects "${projects_dir}")
    if [ "$changed" -eq "1" ]; then
      echo "SCAN: configuration changed"
      restartnginx
    else
      echo "SCAN: no configuration change"
    fi
  else
    error_message "SCAN: stack need to be up"
  fi
}

