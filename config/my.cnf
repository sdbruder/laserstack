# laserstack mounts this file into the app container as /etc/my.cnf.d/laserstack.cnf.
#
# The database containers of the stack have no TLS. The client of the app
# images of PHP 8.2 and newer requires TLS by default and then fails with
# "SSL is required, but the server does not support it". The /root/.bashrc of
# the image writes "skip-ssl" into ~/.my.cnf, but only an interactive shell
# runs that file. This config covers every invocation of the client.

[client]

skip-ssl
