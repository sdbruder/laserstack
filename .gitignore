.env

# The nginx program of the stack writes the multi-project vhost into /etc/nginx
# of the container, laser scan writes one vhost per project here. app.conf is a
# local override. Everything else under config/ belongs to the repository.
config/nginx/http.d/*
!config/nginx/http.d/multiProjectLaravel.conf.template
!config/nginx/http.d/multiProjectLaravelHttps.conf.template

# laser tls writes these: the local certificate authority of the machine and
# the certificate it issues, never the repository.
config/tls/
